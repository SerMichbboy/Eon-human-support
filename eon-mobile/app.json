{
  "expo": {
    "name": "Eon",
    "slug": "eon-human-support",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eon.humansuport",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Eon использует микрофон для голосового общения с компаньоном."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F14"
      },
      "package": "com.eon.humansupport",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Eon использует микрофон для голосового общения."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "8055b2cf-3083-4831-a721-07ad20076278"
      }
    },
    "owner": "sermich"
  }
}
